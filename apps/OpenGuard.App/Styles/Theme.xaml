<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="OpenGuardBackgroundColor">#FF08090B</Color>
    <Color x:Key="OpenGuardSurfaceColor">#FF0F1115</Color>
    <Color x:Key="OpenGuardSurfaceRaisedColor">#FF171A20</Color>
    <Color x:Key="OpenGuardBorderColor">#FF292D35</Color>
    <Color x:Key="OpenGuardTextColor">#FFF3F5F7</Color>
    <Color x:Key="OpenGuardMutedColor">#FF9197A3</Color>
    <Color x:Key="OpenGuardAccentColor">#FF62E7F2</Color>
    <Color x:Key="OpenGuardSuccessColor">#FF62D9A6</Color>
    <Color x:Key="OpenGuardWarningColor">#FFF2BE62</Color>
    <Color x:Key="OpenGuardDangerColor">#FFFF6B72</Color>

    <SolidColorBrush x:Key="OpenGuardBackgroundBrush" Color="{StaticResource OpenGuardBackgroundColor}" />
    <SolidColorBrush x:Key="OpenGuardSurfaceBrush" Color="{StaticResource OpenGuardSurfaceColor}" />
    <SolidColorBrush x:Key="OpenGuardSurfaceRaisedBrush" Color="{StaticResource OpenGuardSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="OpenGuardBorderBrush" Color="{StaticResource OpenGuardBorderColor}" />
    <SolidColorBrush x:Key="OpenGuardTextBrush" Color="{StaticResource OpenGuardTextColor}" />
    <SolidColorBrush x:Key="OpenGuardMutedBrush" Color="{StaticResource OpenGuardMutedColor}" />
    <SolidColorBrush x:Key="OpenGuardAccentBrush" Color="{StaticResource OpenGuardAccentColor}" />
    <SolidColorBrush x:Key="OpenGuardSuccessBrush" Color="{StaticResource OpenGuardSuccessColor}" />
    <SolidColorBrush x:Key="OpenGuardWarningBrush" Color="{StaticResource OpenGuardWarningColor}" />
    <SolidColorBrush x:Key="OpenGuardDangerBrush" Color="{StaticResource OpenGuardDangerColor}" />
    <SolidColorBrush x:Key="OpenGuardSurfaceHoverBrush" Color="#FF1B1F25" />
    <SolidColorBrush x:Key="OpenGuardSurfacePressedBrush" Color="#FF20252C" />

    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource OpenGuardBackgroundColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource OpenGuardTextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource OpenGuardMutedColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource OpenGuardAccentColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource OpenGuardBorderColor}" />

    <!-- Keep WinUI chrome on the same graphite palette as the application. -->
    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="#00000000" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FF15181D" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#FF1C2026" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF191B20" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF1E2228" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FF22272E" />
    <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
    <x:Double x:Key="NavigationViewSelectionIndicatorHeight">30</x:Double>

    <!-- WinUI's stock ScrollBar template consumes these theme keys. -->
    <SolidColorBrush x:Key="ScrollBarBackground" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#99101216" />
    <SolidColorBrush x:Key="ScrollBarBackgroundDisabled" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarBorderBrushPointerOver" Color="#60292D35" />
    <SolidColorBrush x:Key="ScrollBarBorderBrushDisabled" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#FF20242B" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#FF292E36" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundDisabled" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#FF737B88" />
    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="{StaticResource OpenGuardTextColor}" />
    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="{StaticResource OpenGuardAccentColor}" />
    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#FF40454E" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#FF4B525D" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#FF737C89" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource OpenGuardAccentColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#FF2B3037" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#CC0D0F12" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#F20D0F12" />
    <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="#660D0F12" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#80292D35" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#FF292D35" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokeDisabled" Color="#40292D35" />
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#FF59616D" />
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackgroundDisabled" Color="#FF2B3037" />
    <x:Double x:Key="ScrollBarSize">12</x:Double>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OpenGuardTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OpenGuardTextBrush}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource OpenGuardMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpenGuardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenGuardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OpenGuardTextBrush}" />
    </Style>

    <Style TargetType="NavigationView">
        <Setter Property="Background" Value="{StaticResource OpenGuardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenGuardTextBrush}" />
    </Style>

    <Style TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="NavigationIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OpenGuardSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenGuardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="TableHeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource OpenGuardMutedBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
</ResourceDictionary>
