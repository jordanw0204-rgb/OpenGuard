<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenGuard.App.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenGuard.App.Controls"
      xmlns:vm="using:OpenGuard.App.ViewModels"
      Background="{StaticResource OpenGuardBackgroundBrush}">
    <Grid Padding="34,30,34,34" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="5">
                <TextBlock Text="Processes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Executable identity, trust, resource use, and explainable behavior signals." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="11,6" CornerRadius="16" Background="{StaticResource OpenGuardSurfaceBrush}" BorderBrush="{StaticResource OpenGuardBorderBrush}" BorderThickness="1">
                <TextBlock Text="{x:Bind ViewModel.ProcessSortText, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource OpenGuardMutedBrush}" />
            </Border>
        </Grid>
        <controls:ActivityGraph
            Grid.Row="1"
            Title="Process activity"
            PrimaryLabel="CPU"
            SecondaryLabel="MEMORY"
            PrimaryValueText="{x:Bind ViewModel.ProcessCpuValueText, Mode=OneWay}"
            SecondaryValueText="{x:Bind ViewModel.ProcessMemoryValueText, Mode=OneWay}"
            PrimaryValues="{x:Bind ViewModel.ProcessCpuHistory, Mode=OneWay}"
            SecondaryValues="{x:Bind ViewModel.ProcessMemoryHistory, Mode=OneWay}"
            PrimaryStroke="{StaticResource OpenGuardAccentBrush}"
            SecondaryStroke="{StaticResource OpenGuardWarningBrush}"
            SharedScale="False" />
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="ProcessFilter" PlaceholderText="Filter by app, PID, path, signer, or evidence" TextChanged="OnFilterChanged" />
            <ComboBox x:Name="RiskFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All risk levels" /><ComboBoxItem Content="Needs review" /><ComboBoxItem Content="New only" />
            </ComboBox>
            <Button x:Name="InvestigateSelectedButton" Grid.Column="2" Content="Investigate" IsEnabled="False" Click="OnInvestigateSelected" />
            <Button x:Name="ScanSelectedButton" Grid.Column="3" Content="Scan selected" IsEnabled="False" Click="OnScanSelected" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource PanelCardStyle}" Padding="0" Clip="{x:Null}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="14,0" Background="{StaticResource OpenGuardSurfaceRaisedBrush}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <Button x:Name="ApplicationHeader" Tag="Application" Content="APPLICATION" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="PidHeader" Grid.Column="1" Tag="Pid" Content="PID" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="CpuHeader" Grid.Column="2" Tag="Cpu" Content="CPU ▼" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="MemoryHeader" Grid.Column="3" Tag="Memory" Content="MEMORY" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="TrustHeader" Grid.Column="4" Tag="Trust" Content="TRUST" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="RiskHeader" Grid.Column="5" Tag="Risk" Content="RISK" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                </Grid>
                <ListView
                    x:Name="ProcessList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionMode="Single"
                    SelectionChanged="OnProcessSelectionChanged"
                    DoubleTapped="OnProcessDoubleTapped"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="58" />
                            <Setter Property="Padding" Value="18,7" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Investigate process" Tag="{x:Bind PidValue, Mode=OneWay}" Click="OnInvestigateFromMenu" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Open file location" Tag="{x:Bind ScanPath, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnOpenFileLocation" />
                                        <MenuFlyoutItem Text="Scan with OpenGuard" Tag="{x:Bind ScanPath, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnScanFromMenu" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Suspend process…" Tag="{x:Bind PidValue, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnSuspendProcess" />
                                        <MenuFlyoutItem Text="Resume process…" Tag="{x:Bind PidValue, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnResumeProcess" />
                                        <MenuFlyoutItem Text="Terminate process…" Tag="{x:Bind PidValue, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnTerminateProcess" />
                                        <MenuFlyoutItem Text="Terminate process tree…" Tag="{x:Bind PidValue, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnTerminateProcessTree" />
                                        <MenuFlyoutItem Text="Quarantine executable…" Tag="{x:Bind PidValue, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnQuarantineExecutable" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Search process on web" Tag="{x:Bind Application, Mode=OneWay}" Click="OnSearchWeb" />
                                        <MenuFlyoutItem Text="Copy executable path" Tag="{x:Bind ScanPath, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnCopyText" />
                                        <MenuFlyoutItem Text="Copy process details" Tag="{x:Bind DetailsText, Mode=OneWay}" Click="OnCopyText" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Application, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Path, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Pid, Mode=OneWay}" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Memory, Mode=OneWay}" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Trust, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Risk, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource OpenGuardWarningBrush}" ToolTipService.ToolTip="{x:Bind RiskDetail, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
