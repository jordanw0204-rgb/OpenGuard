<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenGuard.App.Pages.DetectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:OpenGuard.App.ViewModels"
    Background="{StaticResource OpenGuardBackgroundBrush}"
    Loaded="OnLoaded">

    <Grid Padding="34,30,34,34" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Detections" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Evidence-backed changes and suspicious behavior, ordered newest first." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    <TextBlock Text="Refresh timeline" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="8">
            <ListView ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DetectionEventViewModel">
                        <Grid Padding="12,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Border Height="28" CornerRadius="9" Background="{StaticResource OpenGuardSurfaceRaisedBrush}" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind Severity}" FontSize="10" CharacterSpacing="70" FontWeight="SemiBold" Foreground="{StaticResource OpenGuardAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" MaxLines="3" />
                                <TextBlock Text="{x:Bind Path}" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource OpenGuardMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind StateText}" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource OpenGuardMutedBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind CreatedText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind ProcessText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
