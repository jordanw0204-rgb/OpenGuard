<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenGuard.App.Pages.InvestigationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:OpenGuard.App.ViewModels"
      Background="{StaticResource OpenGuardBackgroundBrush}">
    <Grid Padding="34,30,34,34" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Text="Investigation" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Correlate process, file, network, persistence, detection, and response evidence over time." Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="TimelineSearch" PlaceholderText="Search title, detail, path, IP, or host" KeyDown="OnSearchKeyDown" />
            <ComboBox x:Name="CategoryFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="All evidence" Tag="all" />
                <ComboBoxItem Content="Processes" Tag="process" />
                <ComboBoxItem Content="Files" Tag="file" />
                <ComboBoxItem Content="Network" Tag="network" />
                <ComboBoxItem Content="Persistence" Tag="persistence" />
                <ComboBoxItem Content="Detections" Tag="detection" />
                <ComboBoxItem Content="Responses" Tag="response" />
                <ComboBoxItem Content="System" Tag="system" />
            </ComboBox>
            <Button Grid.Column="2" Content="Refresh" Click="OnRefreshTimeline" />
            <Button Grid.Column="3" Content="Load older" IsEnabled="{x:Bind ViewModel.CanLoadOlder, Mode=OneWay}" Click="OnLoadOlder" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Padding="18,14" Spacing="3" Background="{StaticResource OpenGuardSurfaceRaisedBrush}">
                        <TextBlock Text="HISTORICAL TIMELINE" FontFamily="Cascadia Mono" FontSize="11" CharacterSpacing="110" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TimelineStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}" SelectionMode="None" Background="Transparent">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="16,10" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineItemViewModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind Category}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource OpenGuardAccentBrush}" />
                                        <TextBlock Text="{x:Bind Severity}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource OpenGuardWarningBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" MaxLines="3" />
                                        <TextBlock Text="{x:Bind Context}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource OpenGuardMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind OccurredText}" HorizontalAlignment="Right" Foreground="{StaticResource OpenGuardMutedBrush}" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Padding="18,14" Background="{StaticResource OpenGuardSurfaceRaisedBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="PERSISTENCE INVENTORY" FontFamily="Cascadia Mono" FontSize="11" CharacterSpacing="110" Foreground="{StaticResource OpenGuardMutedBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PersistenceStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Rescan" IsEnabled="{x:Bind ViewModel.CanRefreshPersistence, Mode=OneWay}" Click="OnRefreshPersistence" />
                    </Grid>
                    <ListView x:Name="PersistenceList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Persistence, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPersistence, Mode=TwoWay}" Background="Transparent">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="16,10" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PersistenceItemViewModel">
                                <StackPanel Spacing="4">
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Risk}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource OpenGuardWarningBrush}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Category}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource OpenGuardAccentBrush}" />
                                    <TextBlock Text="{x:Bind Command}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind Command}" />
                                    <TextBlock Text="{x:Bind Evidence}" Style="{StaticResource MutedTextStyle}" FontSize="10" TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" Padding="14" ColumnSpacing="8" Background="{StaticResource OpenGuardSurfaceRaisedBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="Disable selected" IsEnabled="{x:Bind ViewModel.CanDisableSelected, Mode=OneWay}" Click="OnDisablePersistence" />
                        <Button Grid.Column="1" Content="Undo last change" IsEnabled="{x:Bind ViewModel.CanRestoreLast, Mode=OneWay}" Click="OnRestorePersistence" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
