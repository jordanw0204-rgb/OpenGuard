<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="OpenGuard.App.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:OpenGuard.App.Controls"
      xmlns:vm="using:OpenGuard.App.ViewModels"
      Background="{StaticResource OpenGuardBackgroundBrush}">
    <Grid Padding="34,30,34,34" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Spacing="5">
                <TextBlock Text="Network activity" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="See which executable owns each flow, where it goes, and how much data is moving." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="11,6" CornerRadius="16" Background="{StaticResource OpenGuardSurfaceBrush}" BorderBrush="{StaticResource OpenGuardBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="{x:Bind ViewModel.DownloadRateText, Mode=OneWay}" FontFamily="Cascadia Mono" Foreground="{StaticResource OpenGuardAccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.UploadRateText, Mode=OneWay}" FontFamily="Cascadia Mono" Foreground="{StaticResource OpenGuardSuccessBrush}" />
                </StackPanel>
            </Border>
        </Grid>
        <controls:ActivityGraph
            Grid.Row="1"
            Title="Network throughput"
            PrimaryLabel="DOWNLOAD"
            SecondaryLabel="UPLOAD"
            PrimaryValueText="{x:Bind ViewModel.DownloadRateText, Mode=OneWay}"
            SecondaryValueText="{x:Bind ViewModel.UploadRateText, Mode=OneWay}"
            PrimaryValues="{x:Bind ViewModel.NetworkDownloadHistory, Mode=OneWay}"
            SecondaryValues="{x:Bind ViewModel.NetworkUploadHistory, Mode=OneWay}"
            PrimaryStroke="{StaticResource OpenGuardAccentBrush}"
            SecondaryStroke="{StaticResource OpenGuardSuccessBrush}" />
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="NetworkFilter" PlaceholderText="Filter app, host, IP, port, protocol, or reputation" TextChanged="OnFilterChanged" />
            <ComboBox x:Name="ProtocolFilter" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All protocols" /><ComboBoxItem Content="TCP" /><ComboBoxItem Content="UDP" />
            </ComboBox>
            <Border Grid.Column="2" MinWidth="175" Padding="11,6" CornerRadius="9" Background="{StaticResource OpenGuardSurfaceRaisedBrush}" BorderBrush="{StaticResource OpenGuardBorderBrush}" BorderThickness="1">
                <TextBlock Text="{x:Bind ViewModel.NetworkSortText, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource OpenGuardMutedBrush}" />
            </Border>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource PanelCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="14,0" Background="{StaticResource OpenGuardSurfaceRaisedBrush}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                    <Button x:Name="ApplicationHeader" Tag="Application" Content="APPLICATION" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="DownloadHeader" Grid.Column="1" Tag="Download" Content="DOWNLOAD ▼" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="UploadHeader" Grid.Column="2" Tag="Upload" Content="UPLOAD" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="DestinationHeader" Grid.Column="3" Tag="Destination" Content="DESTINATION" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="ReputationHeader" Grid.Column="4" Tag="Reputation" Content="REPUTATION" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                    <Button x:Name="ProtocolHeader" Grid.Column="5" Tag="Protocol" Content="PROTOCOL" Style="{StaticResource TableHeaderButtonStyle}" Click="OnSortHeaderClicked" />
                </Grid>
                <ListView
                    x:Name="NetworkList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.NetworkEndpoints, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="60" />
                            <Setter Property="Padding" Value="18,7" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Investigate owning process" Tag="{x:Bind ProcessId, Mode=OneWay}" Click="OnInvestigateFromMenu" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Open process file location" Tag="{x:Bind ProcessPath, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnOpenFileLocation" />
                                        <MenuFlyoutItem Text="Scan process with OpenGuard" Tag="{x:Bind ProcessPath, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnScanFromMenu" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Block destination for 15 minutes…" Tag="{x:Bind}" IsEnabled="{x:Bind CanBlockRemote, Mode=OneWay}" Click="OnBlockDestination" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Search process on web" Tag="{x:Bind Application, Mode=OneWay}" Click="OnSearchWeb" />
                                        <MenuFlyoutItem Text="Copy executable path" Tag="{x:Bind ProcessPath, Mode=OneWay}" IsEnabled="{x:Bind HasProcessPath, Mode=OneWay}" Click="OnCopyText" />
                                        <MenuFlyoutItem Text="Copy destination" Tag="{x:Bind Destination, Mode=OneWay}" Click="OnCopyText" />
                                        <MenuFlyoutItem Text="Copy connection details" Tag="{x:Bind ConnectionSummary, Mode=OneWay}" Click="OnCopyText" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Application, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ProcessDetail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Download, Mode=OneWay}" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Upload, Mode=OneWay}" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Destination, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Destination, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind DestinationDetail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{x:Bind Reputation, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Protocol, Mode=OneWay}" FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
