<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenGuard.App.Pages.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:OpenGuard.App.ViewModels"
    Background="{StaticResource OpenGuardBackgroundBrush}"
    Loaded="OnLoaded">

    <Grid Padding="34,30,34,34" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Quarantine" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Defanged, hash-verified isolation with explicit recovery." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="No automatic deletion"
            Message="Files are re-scanned, copied into a non-executable container, SHA-256 verified, and only then removed from their original location." />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCardStyle}" Padding="8">
                <ListView
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:QuarantineItemViewModel">
                            <Grid Padding="10,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource OpenGuardSurfaceRaisedBrush}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="17" Foreground="{StaticResource OpenGuardAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind StateText}" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource OpenGuardMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Selected item" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="ORIGINAL PATH" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.OriginalPath, Mode=OneWay, FallbackValue='Select an item to inspect'}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock Text="SHA-256" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.Sha256, Mode=OneWay, FallbackValue='—'}" FontFamily="Cascadia Mono" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Spacing="4">
                        <TextBlock Text="WHY IT WAS ISOLATED" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedItem.Reason, Mode=OneWay, FallbackValue='No quarantine item selected.'}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Row="4"
                        HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.RestoreSelectedCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="15" />
                            <TextBlock Text="Restore original" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
