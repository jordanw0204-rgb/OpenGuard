<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenGuard.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource OpenGuardBackgroundBrush}">
    <ScrollViewer>
        <Grid Padding="34,30,34,44" RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="System posture" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="A focused view of what changed, what is exposed, and what needs attention." Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Click="OnRefreshClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="24">
                <Grid ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="18" Background="#18292D">
                        <FontIcon Glyph="&#xE95E;" FontSize="26" Foreground="{StaticResource OpenGuardAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ServiceHeadline, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Process, network, scan, and detection state stay local and travel through the authenticated native channel." Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="12,7" CornerRadius="18" BorderThickness="1" BorderBrush="#4D3D3420" Background="#1FF2BE62" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ServiceBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource OpenGuardWarningBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="RUNNING PROCESSES" FontSize="10" CharacterSpacing="110" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ProcessCountText, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="Native Tool Help inventory" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ACTIVE CONNECTIONS" FontSize="10" CharacterSpacing="110" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionCountText, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="Owned TCP destinations" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="UNREVIEWED EVENTS" FontSize="10" CharacterSpacing="110" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.EventCountText, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="Explainable evidence only" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CURRENT TRANSFER" FontSize="10" CharacterSpacing="110" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TransferRateText, Mode=OneWay}" Style="{StaticResource MetricValueStyle}" />
                        <TextBlock Text="Measured TCP up + down" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelCardStyle}" MinHeight="290">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Investigation timeline" Style="{StaticResource SectionTitleStyle}" />
                            <Button HorizontalAlignment="Right" Padding="12,6" Content="View all" />
                        </Grid>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <FontIcon Glyph="&#xEA86;" FontSize="34" Foreground="{StaticResource OpenGuardMutedBrush}" />
                            <TextBlock Text="No native events yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Events will appear here as soon as the new service connects." Style="{StaticResource MutedTextStyle}" TextAlignment="Center" MaxWidth="320" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Coverage" Style="{StaticResource SectionTitleStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE930;" FontSize="18" Foreground="{StaticResource OpenGuardAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Process events" FontWeight="SemiBold" /><TextBlock Text="ETW + reconciliation" Style="{StaticResource MutedTextStyle}" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ProcessCoverageText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource OpenGuardWarningBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource OpenGuardBorderBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE968;" FontSize="18" Foreground="{StaticResource OpenGuardAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Network activity" FontWeight="SemiBold" /><TextBlock Text="Owner PID + TCP EStats" Style="{StaticResource MutedTextStyle}" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NetworkCoverageText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource OpenGuardWarningBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource OpenGuardBorderBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource OpenGuardAccentBrush}" />
                            <StackPanel Grid.Column="1"><TextBlock Text="Content engine" FontWeight="SemiBold" /><TextBlock Text="YARA-X + AMSI" Style="{StaticResource MutedTextStyle}" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ContentCoverageText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource OpenGuardWarningBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
