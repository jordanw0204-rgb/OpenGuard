<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenGuard.App.Pages.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource OpenGuardBackgroundBrush}">

    <ScrollViewer>
        <Grid Padding="34,30,34,44" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="5">
                <TextBlock Text="Scanner" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="Explainable native analysis using streaming SHA-256, YARA-X content rules, PE inspection, and script heuristics."
                    Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    MinHeight="110"
                    HorizontalAlignment="Stretch"
                    Click="OnSelectFile"
                    IsEnabled="{x:Bind ViewModel.CanStartScan, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="{StaticResource OpenGuardAccentBrush}" />
                        <TextBlock Text="Scan a file" FontWeight="SemiBold" />
                        <TextBlock Text="Choose any local file" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" MinHeight="110" HorizontalAlignment="Stretch" Click="OnSelectFolder" IsEnabled="{x:Bind ViewModel.CanStartScan, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="Scan a folder" FontWeight="SemiBold" />
                        <TextBlock Text="Recursive, no symlink traversal" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    MinHeight="110"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.CancelScanCommand, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="26" Foreground="{StaticResource OpenGuardDangerBrush}" />
                        <TextBlock Text="Cancel scan" FontWeight="SemiBold" />
                        <TextBlock Text="Stops after the current block" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="18">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Scan profiles" FontWeight="SemiBold" />
                        <TextBlock Text="Known folders are resolved for your signed-in Windows account." Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Quick" Tag="quick" Click="OnScanProfile" IsEnabled="{x:Bind ViewModel.CanStartScan, Mode=OneWay}" />
                    <Button Grid.Column="2" Content="Downloads" Tag="downloads" Click="OnScanProfile" IsEnabled="{x:Bind ViewModel.CanStartScan, Mode=OneWay}" />
                    <Button Grid.Column="3" Content="Startup" Tag="startup" Click="OnScanProfile" IsEnabled="{x:Bind ViewModel.CanStartScan, Mode=OneWay}" />
                    <Button Grid.Column="4" Content="Full PC" Tag="full" Click="OnScanProfile" IsEnabled="{x:Bind ViewModel.CanStartScan, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource PanelCardStyle}" MinHeight="390">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="62" Height="62" CornerRadius="20" Background="{StaticResource OpenGuardSurfaceRaisedBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE9D9;" FontSize="27" Foreground="{StaticResource OpenGuardAccentBrush}" />
                                <ProgressRing Width="52" Height="52" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind ViewModel.VerdictText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource OpenGuardAccentBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                            <Button
                                Margin="0,6,0,0"
                                Command="{x:Bind ViewModel.QuarantineLatestCommand}"
                                IsEnabled="{x:Bind ViewModel.CanQuarantine, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="Quarantine" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource OpenGuardSurfaceRaisedBrush}" CornerRadius="10" Padding="16">
                        <Grid ColumnSpacing="18" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="TARGET" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource OpenGuardMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TargetPath, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Text="SHA-256" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource OpenGuardMutedBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.HashText, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="ENGINES" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource OpenGuardMutedBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.EngineText, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <TextBlock Text="Detection evidence" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Evidence, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource OpenGuardAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource OpenGuardTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
