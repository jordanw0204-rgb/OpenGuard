<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenGuard.App.Controls.ActivityGraph"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="168">
    <Border Style="{StaticResource PanelCardStyle}" Padding="18,16,18,13">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="108" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Rolling activity history" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding PrimaryStroke, ElementName=Root}" />
                    <StackPanel>
                        <TextBlock Text="{Binding PrimaryLabel, ElementName=Root}" FontSize="9" CharacterSpacing="90" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{Binding PrimaryValueText, ElementName=Root}" FontFamily="Cascadia Mono" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding SecondaryStroke, ElementName=Root}" />
                    <StackPanel>
                        <TextBlock Text="{Binding SecondaryLabel, ElementName=Root}" FontSize="9" CharacterSpacing="90" Foreground="{StaticResource OpenGuardMutedBrush}" />
                        <TextBlock Text="{Binding SecondaryValueText, ElementName=Root}" FontFamily="Cascadia Mono" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Canvas x:Name="PlotCanvas" Grid.Row="1" SizeChanged="OnPlotSizeChanged" />
            <Grid Grid.Row="2">
                <TextBlock Text="OLDER" FontSize="9" CharacterSpacing="90" Foreground="{StaticResource OpenGuardMutedBrush}" />
                <TextBlock Text="UP TO 90 SAMPLES · RELATIVE TREND" HorizontalAlignment="Center" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource OpenGuardMutedBrush}" />
                <TextBlock Text="NOW" HorizontalAlignment="Right" FontSize="9" CharacterSpacing="90" Foreground="{StaticResource OpenGuardMutedBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
